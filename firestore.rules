rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chaque utilisateur ne lit/écrit que son propre document.
    // Phase 1 (test) : le client peut poser premium via le code promo.
    // Phase 2 (lancement) : durcir en interdisant l'écriture de "premium"
    //   côté client (seule la Cloud Function, en admin, l'écrira).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Le pseudo n'est modifiable que par la Cloud Function (accès admin),
      // afin que l'unicité reste garantie et qu'un pseudo ne soit pas volé.
      // À la création, le document ne peut pas contenir de pseudo.
      allow create: if request.auth != null && request.auth.uid == uid
                    && !("pseudo" in request.resource.data.keys())
                    && !("programme" in request.resource.data.keys())
                    && !("ajustements" in request.resource.data.keys())
                    && !("commandeCoach" in request.resource.data.keys());
      // À la mise à jour, pseudo, programme et ajustements doivent rester
      // inchangés. Sans la protection du compteur, le quota ne vaudrait rien :
      // il suffirait de le remettre à zéro depuis le navigateur.
      // Le programme est déposé par le coach via deposerProgramme, qui
      // écrit en admin : sans cette règle, n'importe qui pourrait
      // s'attribuer un plan, et surtout en écrire un chez un autre.
      allow update: if request.auth != null && request.auth.uid == uid
                    && !("pseudo" in request.resource.data.diff(resource.data).affectedKeys())
                    && !("programme" in request.resource.data.diff(resource.data).affectedKeys())
                    && !("ajustements" in request.resource.data.diff(resource.data).affectedKeys())
                    // 26/09 : la commande coaching n'est ecrite que par le
                    // webhook de paiement ; sinon on s'offrirait un plan.
                    && !("commandeCoach" in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Table des pseudonymes : totalement fermée au client.
    // Elle relie un pseudo à un compte ; la rendre lisible permettrait
    // d'énumérer les utilisateurs. Seules les Cloud Functions y accèdent.
    // Quota IA (02/10) : lisible par son proprietaire, ecrit par le
    // serveur seulement (sinon on remettrait son compteur a zero).
    // Invitations par lien (02/10) : serveur seulement.
    match /invitations/{code} {
      allow read, write: if false;
    }
    // Commandes Mollie (17/10) : lisibles par leur proprietaire,
    // ecrites uniquement par le serveur (statut « paid » impossible a falsifier).
    match /commandes/{paymentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /quotasIA/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /usernames/{pseudo} {
      allow read, write: if false;
    }

    // Codes premium : fermes au client, comme les pseudonymes.
    // Lisibles, ils se laisseraient enumerer ; inscriptibles, « une
    // seule fois » ne voudrait plus rien dire. Seule la Cloud Function
    // utiliserCode y touche, en admin et dans une transaction.
    match /codesPremium/{code} {
      allow read, write: if false;
    }

    // Codes de reduction (28/10) : meme principe, et pour les memes raisons.
    // Lisibles, ils se laisseraient enumerer ; inscriptibles, « une seule
    // fois » ne voudrait plus rien dire. Seules les Cloud Functions y touchent
    // (verifierCodeReduction, creerPaiementMollie, mollieWebhook, adminCodesReduction).
    //  - codesReduction/{CODE}      le code, son pourcentage, son etat
    //  - reductionsPersonne/{commande}   HISTORIQUE des usages (une ligne par paiement avec code), jamais un verrou
    //  - essaisCodes/{cle}          compteurs anti-devinette (compte, adresse IP hachee)
    match /codesReduction/{code} {
      allow read, write: if false;
    }
    match /reductionsPersonne/{commande} {
      allow read, write: if false;
    }
    match /essaisCodes/{cle} {
      allow read, write: if false;
    }
  }
}
